# Copy to .env — NEVER commit the real values.
# AGENT_GAMES_HMAC_SECRET: from the dashboard "Rotate Secret" (shown once). Required.
AGENT_GAMES_HMAC_SECRET=
# KURIER_API_KEY: mainnet API key from kurier.xyz. Optional — when unset, Kurier
# submission is skipped and the agent relies on local verification + the
# platform's own re-verification. Set it to enforce finalized-before-approval.
KURIER_API_KEY=
# KURIER_API_URL: override for testnet (https://api-testnet.kurier.xyz/api/v1).
# KURIER_API_URL=https://api.kurier.xyz/api/v1
# PORT: standalone server port (Vercel ignores this).
PORT=3000
# TASKID_MODE: keccak (default) | numeric | raw. Validate against Practice mode.
TASKID_MODE=keccak
# SIGNATURE_FORMAT: bare (default, "<hex>") | sha256 ("sha256=<hex>").
# The platform verifies response signatures against RAW hex — "sha256=" fails its preflight (proven 2026-11-16).
SIGNATURE_FORMAT=bare
# RESPONSE_BUDGET_MS: internal per-task budget (platform deadline is 60s).
# RESPONSE_BUDGET_MS=50000
# KURIER_WAIT_MS: max wait for a Kurier Finalized result on the APPROVE path.
# KURIER_WAIT_MS=40000
